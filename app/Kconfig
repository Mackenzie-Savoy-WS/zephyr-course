config APP_HEARTBEAT_PERIOD_MS
    int "Heartbeat period (ms)"
    range 100 10000
    default 500
    
menuconfig LED_SUBSYSTEM
    bool "LED Subsystem"

if LED_SUBSYSTEM

    choice
        prompt "LED blink sleep time"
        default LED_SLEEP_TIME_1000MS
        config LED_SLEEP_TIME_250MS
            bool "250ms (fastest)"
        config LED_SLEEP_TIME_500MS
            bool "500ms (fast)"
        config LED_SLEEP_TIME_1000MS
            bool "1s (medium)"
        config LED_SLEEP_TIME_2000MS
            bool "2s (slow)"
    endchoice

    # Hidden INT
    config BLINK_TIME_MS
        int
        default 250 if LED_SLEEP_TIME_250MS
        default 500 if LED_SLEEP_TIME_500MS
        default 1000 if LED_SLEEP_TIME_1000MS
        default 2000 if LED_SLEEP_TIME_2000MS
        default 0

    menuconfig ADVANCED_LED_SETTINGS
        bool "Advanced LED Settings"
        depends on LED_SUBSYSTEM
        if ADVANCED_LED_SETTINGS
            config LED_BRIGHTNESS
                int "LED Brightness (0-100)"
                range 0 100
                default 100

            config LED_FADE_DURATION
                int "LED Fade Duration (ms)"
                range 0 5000
                default 500
            menu "Expert Settings"
                visible if ADVANCED_LED_SETTINGS
                config LED_DEBUG_ENABLED
                    bool "Enable LED Debugging"
                    default n
                config LED_CUSTOM_PATTERN
                    bool "Custom LED Blink Pattern"
                    default n
            endmenu
        endif

endif # LED_SUBSYSTEM

source "Kconfig.zephyr"
rsource "drivers/our_driver/Kconfig"
